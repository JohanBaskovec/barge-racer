{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barge-racer",
  "compatibility_date": "2025-11-01",
  // The Worker hosts multiplayer rooms (/api/room/CODE) and serves the game from dist/.
  "main": "server/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RaceRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RaceRoom"] }]
}
